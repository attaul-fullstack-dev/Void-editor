<?xml version="1.0" encoding="utf-8"?>
<!--
    Kredensial SFTP (host, user, password, private key) disimpan di
    EncryptedSharedPreferences. Tanpa aturan ini, backup adb/cloud bisa membawa
    keluar berkas tersebut dari device. Semua jalur backup ditolak.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
